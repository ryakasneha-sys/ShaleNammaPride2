rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(role) { return isSignedIn() && getUserData().role == role; }
    function isAdmin() { return hasRole('admin'); }
    function isHeadmaster() { return hasRole('headmaster'); }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Multi-Language Support: Language pref is local, but profile can store it
    
    // 1. Users Collection
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId 
                    && incoming().role == 'parent' // Default to parent on self-creation
                    && incoming().keys().hasAll(['uid', 'role'])
                    && incoming().keys().size() == 2;
      allow update: if isAdmin() && incoming().keys().hasAll(['role']);
    }

    // 2. Daily Meals
    // ID should be YYYY-MM-DD
    match /dailyMeals/{mealId} {
      function isValidMeal(data) {
        return data.date is string && data.date.size() == 10
               && data.imageUrl is string && data.imageUrl.size() < 2000
               && data.description is string && data.description.size() <= 500
               && data.createdAt == request.time;
      }
      
      allow read: if true; // Public list
      allow create: if (isAdmin() || isHeadmaster()) && isValidMeal(incoming()) && isValidId(mealId);
      allow update: if (isAdmin() || isHeadmaster()) && isValidMeal(incoming()) 
                    && incoming().diff(existing()).affectedKeys().hasOnly(['imageUrl', 'description']);
      allow delete: if isAdmin();
    }

    // 3. Facility Tour
    match /facilityTour/{facilityId} {
      function isValidFacility(data) {
        return data.title is string && data.title.size() <= 100
               && data.imageUrl is string && data.imageUrl.size() < 2000
               && data.description is string && data.description.size() <= 1000
               && data.order is int;
      }
      allow read: if true;
      allow create: if isAdmin() && isValidFacility(incoming()) && isValidId(facilityId);
      allow update: if isAdmin() && isValidFacility(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'imageUrl', 'order']);
      allow delete: if isAdmin();
    }

    // 4. Student Stars
    match /studentStars/{starId} {
      function isValidStar(data) {
        return data.name is string && data.name.size() <= 100
               && data.achievement is string && data.achievement.size() <= 500
               && data.imageUrl is string && data.imageUrl.size() < 2000
               && data.date is string
               && data.createdAt == request.time;
      }
      allow read: if true;
      allow create: if (isAdmin() || isHeadmaster()) && isValidStar(incoming()) && isValidId(starId);
      allow update: if (isAdmin() || isHeadmaster()) && isValidStar(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'achievement', 'imageUrl', 'date']);
      allow delete: if (isAdmin() || isHeadmaster());
    }

    // 5. Feedback
    match /feedback/{feedbackId} {
      function isValidFeedback(data) {
        return data.message is string && data.message.size() <= 2000
               && data.isAnonymous is bool
               && data.createdAt == request.time
               && (!data.isAnonymous ? data.userId == request.auth.uid : true);
      }
      allow create: if isSignedIn() && isValidFeedback(incoming());
      allow read, list: if isAdmin() || isHeadmaster(); // Only staff can read feedback
      // No updates or deletes for feedback to preserve record integrity
    }
  }
}
